# Flask Configuration
FLASK_DEBUG=false
SECRET_KEY=your-secret-key-here-change-this-in-production

# Model Configuration
USE_ONLY_RF=true
ACTIVE_MODEL=ensemble

# Server Configuration
PORT=5000
WORKERS=2
THREADS=4

# Python Version
PYTHON_VERSION=3.12.4

# Optional: Database
DATABASE_URL=sqlite:///app.db
